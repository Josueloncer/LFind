{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LFind",
  "version": "0.1.0",
  "identifier": "app.nova.explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LFind",
        "width": 1240,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://lfview.localhost; media-src http://lfview.localhost; connect-src 'self' ipc: http://ipc.localhost http://lfview.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MDczRDg0NDNBQkFCNzgKUldSNHE2dERoRDBIZFljYVJZZlRtQUtSUkovRWFoaTlOOUcrblhPL04wdU9SVWpSTVRvMkRBR0kK",
      "endpoints": [
        "https://github.com/Josueloncer/LFind/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
